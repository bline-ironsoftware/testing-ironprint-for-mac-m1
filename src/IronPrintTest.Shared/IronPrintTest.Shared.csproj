<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net11.0-macos;net11.0-maccatalyst;net11.0-ios;net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MAUI only for the MAUI app's platforms. Not for net11.0-macos (a plain native
         console target) or plain net11.0, so the console app builds without MAUI workloads. -->
    <IsMauiTarget>false</IsMauiTarget>
    <IsMauiTarget Condition="$(TargetFramework.Contains('-')) and '$(TargetFramework)' != 'net11.0-macos'">true</IsMauiTarget>
    <UseMaui Condition="'$(IsMauiTarget)' == 'true'">true</UseMaui>
    <SingleProject Condition="'$(IsMauiTarget)' == 'true'">true</SingleProject>
    <!-- No MAUI conditional compilation symbols (ANDROID/IOS/MACCATALYST) get defined for this
         TFM since MAUI isn't involved here, so define our own for PlatformPrinterNames.cs. -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net11.0-macos'">$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <IronPrintTestVersion Condition="'$(IronPrintTestVersion)' == ''">2026.11.1</IronPrintTestVersion>
    <IronPrintXamarinTestVersion Condition="'$(IronPrintXamarinTestVersion)' == ''">2026.11.1</IronPrintXamarinTestVersion>
  </PropertyGroup>

  <!-- IronPrint.Xamarin has no MacCatalyst asset at all (only monoandroid12.0, xamarin.ios10,
       and a netstandard2.0 fallback with no native platform binding), so MacCatalyst (and the
       native macos console target) stay on the plain IronPrint package, which has genuine native
       net8.0-maccatalyst11.0 and net8.0-macos10.14 builds. -->
  <!-- On net11.0-ios NuGet resolves IronPrint.Xamarin to lib/netstandard2.0 (not xamarin.ios10),
       and every PrintAsync call then throws NotImplementedException. iOS therefore defaults to
       the plain IronPrint package (lib/net8.0-ios10.0). Build with -p:IosUseXamarin=true to
       reproduce the IronPrint.Xamarin result. -->
  <PropertyGroup>
    <IosUseXamarin Condition="'$(IosUseXamarin)' == ''">false</IosUseXamarin>
    <!-- Android defaults to IronPrint.Xamarin; -p:AndroidUseXamarin=false tests plain IronPrint. -->
    <AndroidUseXamarin Condition="'$(AndroidUseXamarin)' == ''">true</AndroidUseXamarin>
    <UseXamarinPackage>false</UseXamarinPackage>
    <UseXamarinPackage Condition="'$(TargetFramework)' == 'net11.0-ios' and '$(IosUseXamarin)' == 'true'">true</UseXamarinPackage>
    <UseXamarinPackage Condition="'$(TargetFramework)' == 'net11.0-android' and '$(AndroidUseXamarin)' == 'true'">true</UseXamarinPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IronPrint" Version="$(IronPrintTestVersion)" Condition="'$(UseXamarinPackage)' != 'true'" />
    <PackageReference Include="IronPrint.Xamarin" Version="$(IronPrintXamarinTestVersion)" Condition="'$(UseXamarinPackage)' == 'true'" />
  </ItemGroup>

</Project>
