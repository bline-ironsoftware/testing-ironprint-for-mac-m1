<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-maccatalyst;net11.0-ios;net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiTest</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>IronPrint .NET 11 Test</ApplicationTitle>
    <ApplicationId>com.ironsoftware.ironprinttest</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net11.0-ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net11.0-android'">24.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetFramework)' == 'net11.0-android'">24.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>

    <CodesignEntitlements Condition="'$(TargetFramework)' == 'net11.0-maccatalyst'">Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>

    <!-- .NET 11 RC3's MacCatalyst/iOS workload packs pin exactly Xcode 27.0; we have 27.1.
         Per https://aka.ms/xcode-requirement this is an untested but often-fine combination,
         not a hard technical requirement, so skip the check rather than installing an older Xcode. -->
    <ValidateXcodeVersion Condition="'$(TargetFramework)' == 'net11.0-maccatalyst' or '$(TargetFramework)' == 'net11.0-ios'">false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2B2E83" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2B2E83" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled under the logical path "TestFiles/..." so FileSystem.OpenAppPackageFileAsync("TestFiles/sample.pdf")
         resolves the same way on MacCatalyst, iOS and Android. -->
    <MauiAsset Include="..\..\TestFiles\sample.pdf" LogicalName="TestFiles/sample.pdf" />
    <MauiAsset Include="..\..\TestFiles\sample.jpg" LogicalName="TestFiles/sample.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IronPrintTest.Shared\IronPrintTest.Shared.csproj" />
  </ItemGroup>

  <!-- Mobile/MacCatalyst processes are sandboxed and can't see the build machine's
       environment variables at runtime, so Environment.GetEnvironmentVariable("SUITE_LICENSE_KEY")
       always returns null on-device. Bake the value in at build time instead, read from
       the SAME env var on whichever machine runs `dotnet build`/`dotnet run`. The generated
       file lives under $(IntermediateOutputPath) (obj/, already gitignored) and the key is
       never written anywhere under src/ or committed to git. -->
  <Target Name="GenerateBuildTimeLicenseKey" BeforeTargets="XamlPreCompile;CoreCompile">
    <PropertyGroup>
      <GeneratedLicenseKeyFile>$(IntermediateOutputPath)GeneratedLicenseKey.g.cs</GeneratedLicenseKeyFile>
    </PropertyGroup>
    <ItemGroup>
      <_LicenseKeyLines Include="namespace MauiTest%3B" />
      <_LicenseKeyLines Include="internal static class BuildTimeLicenseKey" />
      <_LicenseKeyLines Include="{" />
      <_LicenseKeyLines Include="    public const string Value = &quot;$(SUITE_LICENSE_KEY)&quot;%3B" />
      <_LicenseKeyLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedLicenseKeyFile)" Lines="@(_LicenseKeyLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(GeneratedLicenseKeyFile)" />
    </ItemGroup>
  </Target>

</Project>
