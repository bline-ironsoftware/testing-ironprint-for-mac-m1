<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-macos</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Same exact-Xcode-27.0 pin as MauiTest's MacCatalyst/iOS targets; see
         https://aka.ms/xcode-requirement. We have 27.1, which is newer, not older. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <ApplicationId>com.ironsoftware.ironprinttest.macosconsole</ApplicationId>

    <!-- IronPrint depends on Pkcs11Interop, whose native PKCS#11 symbols (C_CancelFunction,
         C_CloseSession, etc.) can't be statically resolved under full AOT linking; a standard
         .NET for Mac/iOS workaround for this class of error is running under the Mono
         interpreter instead of fully static/AOT-linked native code. -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IronPrintTest.Shared\IronPrintTest.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\TestFiles\**" Link="TestFiles\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
